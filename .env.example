# Server-side environment variables (DO NOT commit real secrets)
# Place a copy in .env.local on the server or in your hosting provider secret manager.

# Payment gateway secret (use only on server)
GATEWAY_API_KEY=
GATEWAY_DOMAIN=
GATEWAY_RECEIVER_NUMBER=

# Stripe secret key (server only)
STRIPE_SECRET_KEY=

# SMS provider key
SMS_API_KEY=

# JWT / session secret
JWT_SECRET=

# Database connection string
DATABASE_URL=
AUTH_COOKIE_NAME=es_token
REFRESH_COOKIE_NAME=es_refresh
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=x-csrf-token

# CORS / Frontend origins
# Comma-separated list of allowed origins (e.g. https://app.example.com,https://admin.example.com)
ALLOWED_ORIGINS=
# Set to 'true' to allow all origins (not recommended for production)
CORS_ALLOW_ALL=false
# Additional allowed headers (comma-separated)
CORS_ALLOWED_HEADERS=Content-Type,Authorization,x-csrf-token,x-institution-id
# ================================================
# Server Configuration
# ================================================
PORT=5000
NODE_ENV=development

# ================================================
# JWT Configuration
# ================================================
JWT_SECRET=your_super_secret_jwt_key_here_with_at_least_32_characters_1234567890
JWT_EXPIRE=7d

# ================================================
# MongoDB Configuration
# ================================================
# Local MongoDB:
# MONGO_URI=mongodb://localhost:27017/easy_school
# 
# MongoDB Atlas (Cloud):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/easy_school?retryWrites=true&w=majority
MONGO_URI=

MONGO_DB_NAME=easy_school
MONGO_REPLICA_SET=atlas-shard-0
MONGO_SSL=true
MONGO_POOL_SIZE=10
MONGO_PERSISTENCE_ENABLED=true

# ================================================
# Snapshots Configuration
# ================================================
MONGO_SNAPSHOT_COLLECTION=app_snapshots
MONGO_SNAPSHOT_ID=documentwise-main

# ================================================
# Image & Document Uploads
# ================================================
UPLOAD_MAX_SIZE_MB=5
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf
UPLOAD_PATH=uploads/

# ================================================
# Email Configuration — Brevo (Sendinblue) API
# ================================================
# Primary: Brevo HTTP API (recommended — fast, no SMTP handshake needed)
# Get your API key at: https://app.brevo.com/settings/keys/api
EMAIL_ENABLED=true
EMAIL_FROM=noreply@yourdomain.com
BREVO_FROM_NAME=EasySchool
BREVO_API_KEY=your_brevo_api_key_here
# Optional: only needed for Brevo SMTP relay fallback
# BREVO_SMTP_USER=your_verified_sender@yourdomain.com

# ================================================
# SMS Configuration
# ================================================
SMS_ENABLED=true
SMS_PROVIDER=anoncify
SMS_API_URL=https://anoncify.xyz/api/sms
SMS_API_KEY=your_anoncify_api_key
ANONCIFY_SMS_API_KEY=your_anoncify_api_key

# ================================================
# Tenant & Domain Settings
# ================================================
MAIN_DOMAIN=example.com
COOKIE_DOMAIN=.example.com
NEXT_PUBLIC_API_URL=https://api.example.com

# ================================================
# Frontend URLs
# ================================================
FRONTEND_URL=http://localhost:3000
MOBILE_URL=http://localhost:8081

# ================================================
# Stripe Configuration
# ================================================
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=usd

# Logging & Monitoring
LOG_LEVEL=info
# Optional Sentry DSN for centralized error monitoring
SENTRY_DSN=
*** End Patch