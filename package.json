{
  "name": "easy-school-server",
  "version": "1.0.0",
  "description": "easy school School Management System Backend",
  "main": "index.js",
  "scripts": {
    "start": "node --enable-source-maps dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "heroku-postbuild": "npm run build",
    "test": "jest",
    "seed": "npm run build && node dist/scripts/seed.js",
    "seed:quick": "npm run build && node dist/scripts/quickSeed.js",
    "seed:complete": "npm run build && node dist/scripts/seedComplete.js",
    "monthly-sms": "npm run build && node dist/scripts/sendMonthlyGuardianSms.js"
  },
  "dependencies": {
    "@types/archiver": "^6.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/multer": "^1.4.8",
    "@types/node": "^20.5.7",
    "@types/pdfkit": "^0.13.1",
    "@types/qrcode": "^1.5.2",
    "@types/uuid": "^9.0.4",
    "archiver": "^6.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.13.0",
    "qrcode": "^1.5.3",
    "typescript": "^5.2.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.4",
    "jest": "^29.6.2",
    "ts-node-dev": "^2.0.0"
  },
  "keywords": [
    "school",
    "management",
    "easy school"
  ],
  "author": "EasySholl",
  "license": "ISC",
  "engines": {
    "node": "18.x"
  }
}
